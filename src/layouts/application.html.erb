<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= meta[:title] == Site::TITLE ? Site::TITLE : "#{meta[:title]} · #{Site::TITLE}" %></title>
  <meta name="description" content="<%= meta[:description] %>">
  <link rel="canonical" href="<%= Site::URL %>/<%= output.to_s.delete_suffix("index.html") %>">
  <meta property="og:title" content="<%= meta[:title] %>">
  <meta property="og:description" content="<%= meta[:description] %>">
  <meta property="og:site_name" content="<%= Site::TITLE %>">
  <meta property="og:type" content="website">
  <meta name="theme-color" content="#f6f2ea">
  <link rel="icon" href="<%= asset("icon.svg") %>" type="image/svg+xml">
  <link rel="preload" href="<%= asset("fonts/source-serif-4-latin.woff2") %>" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="<%= asset("site.css") %>">
</head>
<body class="flex min-h-screen flex-col bg-paper text-ink antialiased">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-paper focus:px-4 focus:py-2 focus:font-sans">Skip to content</a>
  <%= partial "header" %>
  <main id="main" class="flex-1">
    <%= yield %>
  </main>
  <%= partial "footer" %>
</body>
</html>
